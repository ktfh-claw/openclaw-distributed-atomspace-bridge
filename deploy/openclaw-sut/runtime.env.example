# runtime.env — OpenClaw-SUT gateway container environment (compose env_file).
# deploy.sh stage 4 GENERATES the real file from the orchestrator-provided
# secret env file; this committed example carries PLACEHOLDERS ONLY.
# Never commit the generated file (it is gitignored); never print its values.

# ASI1 provider key (OpenAI-compatible custom provider = ASI1).
# The SUT provider credential is the CUSTOM_API_KEY env ref written by
# onboarding; OPENAI_API_KEY carries the same value for the spec's env
# naming contract.
OPENAI_API_KEY=REPLACE_WITH_ASI1_API_KEY
CUSTOM_API_KEY=REPLACE_WITH_ASI1_API_KEY

# Telegram bot token (operator-oversight channel; --use-env keeps the
# credential lookup in the environment — it is never copied into the config)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# OpenClaw Gateway auth token (env SecretRef via --gateway-token-ref-env)
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_GATEWAY_TOKEN

# OpenClaw state dir (onboarded config + sessions; the openclaw-sut-state
# named volume is mounted there)
OPENCLAW_STATE_DIR=/var/openclaw/state

# SUT skill/bridge environment (non-secret; written by deploy.sh stage 4
# with the DAS origins it discovers on the omega-das-integration-client
# network — placeholders below show the expected shape)
OPENCLAW_SUT_WORKSPACE=/var/openclaw/workspace
OPENCLAW_SUT_DAS_ENABLED=1
OPENCLAW_SUT_WRITE_REQUIRE_REF=1
OPENCLAW_SUT_WRITE_BRIDGE_ORIGIN=http://REPLACE_WITH_WRITE_BRIDGE_IP:8080
OPENCLAW_SUT_READ_PROXY_ORIGIN=http://REPLACE_WITH_READ_PROXY_IP:8080
OPENCLAW_SUT_METTA_LIB_DIR=/opt/sut-metta
